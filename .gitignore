cat > .gitignore <<'EOF'
# Environnement virtuel Python
venv/
.venv/
env/
.env/

# Fichiers Python compilés
__pycache__/
*.py[cod]
*.pyo
*.pyc

# Variables d'environnement / secrets
.env
.env.*
*.pem
*.key
secrets/

# Logs
*.log
logs/

# Cache
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Base de données locale
*.sqlite
*.sqlite3
*.db

# OS
.DS_Store
Thumbs.db
EOF